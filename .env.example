# Copy to .env and adjust. Never commit real secrets.

# --- database (docker compose) ---
POSTGRES_USER=tracemind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracemind
# Backend connection string (compose builds this automatically from the values above)
# TRACEMIND_DATABASE_URL=postgresql+psycopg://tracemind:change-me@localhost:5432/tracemind

# --- security ---
TRACEMIND_ENV=development            # set to "production" in deployed environments
TRACEMIND_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
TRACEMIND_COOKIE_SECURE=false        # true behind HTTPS
TRACEMIND_CORS_ORIGINS=["http://localhost:3000"]
TRACEMIND_ACCESS_TOKEN_TTL_MINUTES=720

# --- public demo ---
TRACEMIND_DEMO_MODE=true             # enables /auth/demo (read-mostly synthetic project)
TRACEMIND_SEED_ON_STARTUP=true       # seeds the synthetic demo project if missing

# --- uploads / object storage ---
TRACEMIND_MAX_UPLOAD_BYTES=26214400
TRACEMIND_MAX_ROWS_PER_UPLOAD=250000
TRACEMIND_STORAGE_BACKEND=local      # local | s3 (s3 requires `pip install boto3`)
TRACEMIND_STORAGE_LOCAL_DIR=./data/uploads
# TRACEMIND_S3_BUCKET=
# TRACEMIND_S3_ENDPOINT_URL=
# TRACEMIND_S3_REGION=

# --- analysis limits ---
TRACEMIND_ANALYSIS_RATE_LIMIT_PER_MINUTE=6
TRACEMIND_INVESTIGATE_RATE_LIMIT_PER_MINUTE=20
TRACEMIND_ANALYSIS_WORKERS=2
TRACEMIND_REQUEST_TIMEOUT_SECONDS=30

# --- LLM writer (optional) ---
# deterministic = no external calls (default). anthropic = Claude via the official SDK.
TRACEMIND_LLM_PROVIDER=deterministic
TRACEMIND_LLM_MODEL=claude-opus-5-5
TRACEMIND_LLM_EFFORT=medium
# TRACEMIND_LLM_API_KEY=            # or set ANTHROPIC_API_KEY
TRACEMIND_LLM_TIMEOUT_SECONDS=90

# --- frontend ---
# URL the Next.js server uses to reach the API (rewrites /api/v1/* to it). Needed at build time.
BACKEND_URL=http://127.0.0.1:8000
